{
  "name": "vscode-codex-helper",
  "displayName": "Codex Helper",
  "description": "Manage Codex sessions as editor tabs — split, drag and compare them side by side, with a sidebar tree for quick switching.",
  "version": "0.0.51",
  "publisher": "hkscript",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexHelper",
          "title": "Codex",
          "icon": "resources/codex.svg"
        }
      ]
    },
    "views": {
      "codexHelper": [
        {
          "id": "codexHelper.sessions",
          "name": "会话",
          "icon": "resources/codex.svg",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexHelper.refresh",
        "title": "Codex: 刷新会话列表",
        "icon": "$(refresh)"
      },
      {
        "command": "codexHelper.openSession",
        "title": "Codex: 打开会话"
      },
      {
        "command": "codexHelper.newSession",
        "title": "Codex: 新建会话",
        "icon": "$(add)"
      },
      {
        "command": "codexHelper.renameSession",
        "title": "Codex: 重命名会话"
      },
      {
        "command": "codexHelper.pinSession",
        "title": "Codex: 置顶会话"
      },
      {
        "command": "codexHelper.archiveSession",
        "title": "Codex: 归档会话",
        "icon": "$(archive)"
      },
      {
        "command": "codexHelper.unarchiveSession",
        "title": "Codex: 取消归档"
      },
      {
        "command": "codexHelper.deleteSession",
        "title": "Codex: 删除会话",
        "icon": "$(trash)"
      },
      {
        "command": "codexHelper.unpinSession",
        "title": "Codex: 取消置顶"
      },
      {
        "command": "codexHelper.setFilter",
        "title": "Codex: 过滤会话",
        "icon": "$(search)"
      },
      {
        "command": "codexHelper.clearFilter",
        "title": "Codex: 清除过滤",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexHelper.loadMore",
        "title": "Codex: 加载更多"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexHelper.newSession",
          "when": "view == codexHelper.sessions",
          "group": "navigation@0"
        },
        {
          "command": "codexHelper.refresh",
          "when": "view == codexHelper.sessions",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Codex Helper",
      "properties": {
        "codexHelper.codexExecutable": {
          "type": "string",
          "default": "",
          "description": "codex 可执行文件路径。留空则回退到 Codex 插件的 chatgpt.cliExecutable 配置，再回退到 Codex 插件自带二进制。"
        },
        "codexHelper.pageSize": {
          "type": "number",
          "default": 50,
          "description": "每次从 codex app-server 拉取的会话条数。"
        },
        "codexHelper.filterByWorkspaceCwd": {
          "type": "boolean",
          "default": false,
          "description": "开启后只列出当前工作区目录下的会话。"
        },
        "codexHelper.sessionOpenMode": {
          "type": "string",
          "enum": [
            "sidebar",
            "editorTab"
          ],
          "enumDescriptions": [
            "复用 Codex 已加载的侧边栏，新建和打开历史会话都在同一个 Webview 中切换，速度快。",
            "每次新建会话打开独立编辑器标签；首次打开每个标签可能等待 Codex Webview 冷启动。"
          ],
          "default": "editorTab",
          "description": "新建会话和打开历史会话的方式。"
        },
        "codexHelper.autoRefreshSeconds": {
          "type": "number",
          "default": 0,
          "description": "自动刷新间隔（秒）。0 表示关闭。"
        },
        "codexHelper.showRunningIndicator": {
          "type": "boolean",
          "default": true,
          "description": "在正在执行回合的会话上显示运行图标。"
        },
        "codexHelper.patchCodexNoRetry": {
          "type": "boolean",
          "default": true,
          "description": "打开或新建会话时，关闭 Codex 扩展宿主与 Statsig 面板的请求重试，并把 Codex 面板的启动超时从 30 秒放宽到 120 秒（避免加载慢时整页变成「Codex could not start」；兼容不同打包结构，改前自动备份为 .orig-noretry）。改动需重载窗口生效。"
        },
        "codexHelper.runningStaleSeconds": {
          "type": "number",
          "default": 300,
          "description": "运行状态的过期阈值（秒）。仅用于无法探测进程归属的平台（macOS / Windows）：超过该时长没有写入的会话不再显示为运行中。Linux 上由进程归属判定，不使用该阈值。"
        },
        "codexHelper.runningPollSeconds": {
          "type": "number",
          "default": 5,
          "description": "文件监听不可用时的兜底轮询间隔（秒）。0 表示关闭兜底轮询。"
        },
        "codexHelper.newSessionReasoningEffort": {
          "type": "string",
          "enum": [
            "remember",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "remember",
          "markdownDescription": "新建会话时用哪个思考级别。`remember` = 跟随你上次真正用过的级别（默认）；`off` = 不干预；其余取值 = 固定用这个级别。级别写在新建会话自己身上，不改全局配置。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/webview",
    "vscode:prepublish": "pnpm run build",
    "package": "node -e \"require('fs').mkdirSync('releases',{recursive:true})\" && pnpm dlx --allow-build=@vscode/vsce-sign @vscode/vsce package --out releases/"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.96.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
